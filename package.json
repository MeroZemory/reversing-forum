{
  "name": "reversing-forum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "review:ui": "node scripts/review-ui.mjs",
    "format": "prettier --write src scripts tests *.ts *.json *.md",
    "format:check": "prettier --check src scripts tests *.ts *.json *.md",
    "db:init": "node --env-file=.env --import tsx scripts/init-db.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "lucide-react": "1.49.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
