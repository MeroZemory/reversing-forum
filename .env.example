BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
SITE_URL=http://127.0.0.1:3000
# Optional private dotenv file for mail/Google configuration.
# AUTH_CONFIG_FILE=C:/_authentication/reversing-auth.env
# RESEND_API_KEY=
# RESEND_FROM=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Register the exact BETTER_AUTH_URL origin plus /api/auth/callback/google.
DATABASE_PATH=./data/forum.sqlite
TYPESAFE_KEY_FILE=C:/_authentication/typesafe-jev-api-key.txt
# Alternatively set TYPESAFE_API_KEY in your private environment.
# Editorial publication requires two real account IDs, configured privately.
EDITOR_USER_ID=
EDITORIAL_AUTHOR_USER_ID=
JEV_BUDGET_USD=10
JEV_BUDGET_PATH=./data/chat-pipeline/jev-budget.sqlite
# Duplicate ambiguity uses isolated Codex CLI and its private budget/account file.
CHAT_MODEL_BUDGET_CONFIG=./data/chat-pipeline/model-budget.json
CHAT_MODEL_BUDGET_PATH=./data/chat-pipeline/model-budget.sqlite
